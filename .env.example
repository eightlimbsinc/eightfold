# ---------------------------------------------------------------------------
# Eightfold — example environment. Copy to `.env` and adjust.
# Never commit real secrets. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (local Postgres or `docker compose up -d db`).
DATABASE_URL="postgresql://eightfold:eightfold@localhost:5432/eightfold"

# Separate database used by integration tests (it is wiped between test runs).
TEST_DATABASE_URL="postgresql://eightfold:eightfold@localhost:5432/eightfold_test"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Public origin of the app (used for redirects, cookies, and invitation links).
BETTER_AUTH_URL="http://localhost:3000"

# Rate limiting for auth endpoints (sign-in, sign-up, password reset).
# Keep "true" except in automated test environments.
AUTH_RATE_LIMIT_ENABLED="true"

# Email delivery adapter. "console" logs password-reset and invitation emails
# to the server console (free, local development). Real providers are optional
# future adapters — see docs/ROADMAP.md.
EMAIL_ADAPTER="console"
